<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaProjectExporter.Core\TiaProjectExporter.Core.csproj" />
    <ProjectReference Include="..\TiaProjectExporter.Application\TiaProjectExporter.Application.csproj" />
    <ProjectReference Include="..\TiaProjectExporter.Infrastructure\TiaProjectExporter.Infrastructure.csproj" />
    <ProjectReference Include="..\TiaProjectExporter.Tia\TiaProjectExporter.Tia.csproj" />
    <ProjectReference Include="..\TiaProjectExporter.Export\TiaProjectExporter.Export.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildOpennessHost" BeforeTargets="Build;Publish">
    <MSBuild Projects="..\TiaProjectExporter.OpennessHost\TiaProjectExporter.OpennessHost.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyOpennessHostArtifacts" AfterTargets="Build;Publish">
    <ItemGroup>
      <_OpennessHostArtifacts Include="..\TiaProjectExporter.OpennessHost\bin\$(Configuration)\net48\*"
                             Exclude="..\TiaProjectExporter.OpennessHost\bin\$(Configuration)\net48\*.pdb;..\TiaProjectExporter.OpennessHost\bin\$(Configuration)\net48\*.xml" />
    </ItemGroup>

    <Copy SourceFiles="@(_OpennessHostArtifacts)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(Identity)')" />

    <Copy SourceFiles="@(_OpennessHostArtifacts)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != '' AND Exists('%(Identity)')" />
  </Target>
</Project>

<Window x:Class="TiaProjectExporter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20"
                Background="#132A13"
                CornerRadius="12">
            <DockPanel>
                <StackPanel>
                    <TextBlock FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="TIA Project Exporter" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="#B7E4C7"
                               Text="{Binding VersionText}" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#D8F3DC"
                               Text="AI-friendly Siemens TIA Portal project export for Git, VS Code, and LLM workflows." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right"
                               Foreground="#D8F3DC"
                               Text="{Binding StatusText}" />
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding ProgressText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,18,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="18"
                    BorderBrush="#B7C9B2"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Text="Export Settings" />

                    <TextBlock Margin="0,16,0,4"
                               Text="TIA Project Path" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 ToolTip="Select a TIA project file (.ap18/.ap19/.ap20)."
                                 Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Padding="12,4"
                                Command="{Binding BrowseProjectPathCommand}"
                                Content="Browse" />
                        <Button Grid.Column="2"
                                Padding="12,4"
                                Command="{Binding ValidateProjectPathCommand}"
                                Content="Validate Project" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#52624D"
                               TextWrapping="Wrap"
                               Text="{Binding ProjectPathValidationText}" />

                    <TextBlock Margin="0,16,0,4"
                               Text="Output Folder" />
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding RecentOutputDirectories}"
                              Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,4"
                               Text="TIA Installation Path Override (optional)" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 ToolTip="Set only when automatic detection fails. Use the TIA root directory containing Siemens.Engineering.dll."
                                 Text="{Binding TiaInstallationPathOverride, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="0,0,8,0"
                                Padding="12,4"
                                Command="{Binding BrowseTiaInstallationPathOverrideCommand}"
                                Content="Browse" />
                        <Button Grid.Column="2"
                                Padding="12,4"
                                Command="{Binding ValidateTiaInstallationPathOverrideCommand}"
                                Content="Validate Path" />
                    </Grid>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#52624D"
                               TextWrapping="Wrap"
                               Text="{Binding TiaInstallationValidationText}" />

                    <TextBlock Margin="0,16,0,4"
                               Text="Safety Offline Password (optional)" />
                    <PasswordBox x:Name="SafetyPasswordBox"
                                 ToolTip="Optional: used for Openness SafetyAdministration login before exporting protected fail-safe blocks."
                                 PasswordChanged="OnSafetyPasswordChanged" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#52624D"
                               TextWrapping="Wrap"
                               Text="Leave empty if the project has no F-password. The password is used in-memory for the current export run only." />

                    <TextBlock Margin="0,16,0,6"
                               Text="Formats" />
                    <WrapPanel>
                        <CheckBox Margin="0,0,12,0"
                                  Content="JSON"
                                  IsChecked="{Binding ExportJson}" />
                        <CheckBox Margin="0,0,12,0"
                                  Content="XML"
                                  IsChecked="{Binding ExportXml}" />
                        <CheckBox Content="Markdown"
                                  IsChecked="{Binding ExportMarkdown}" />
                    </WrapPanel>

                    <CheckBox Margin="0,16,0,0"
                              Content="Enable compression"
                              IsChecked="{Binding EnableCompression}" />
                    <CheckBox Margin="0,10,0,0"
                              Content="Skip diagnostics"
                              IsChecked="{Binding SkipDiagnostics}" />

                    <TextBlock Margin="0,16,0,6"
                               Text="Selective Export (after Scan)" />
                    <Border Padding="10"
                            Background="#F8FBF5"
                            BorderBrush="#DDE7D7"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="#52624D"
                                       TextWrapping="Wrap"
                                       Text="{Binding InventoryScanStatusText}" />
                            <ListBox Margin="0,8,0,0"
                                     MaxHeight="160"
                                     ItemsSource="{Binding SelectableDomains}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="0,2,0,2"
                                                  IsChecked="{Binding IsSelected}"
                                                  Content="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,22,0,0"
                                Orientation="Horizontal">
                        <Button Width="170"
                                Margin="0,0,10,0"
                                Command="{Binding DiscoverVersionsCommand}"
                                Content="Detect TIA Versions" />
                        <Button Width="130"
                                Margin="0,0,10,0"
                                Command="{Binding RunHealthCheckCommand}"
                                Content="Health Check" />
                        <Button Width="190"
                                Margin="0,0,10,0"
                                Command="{Binding ScanProjectContentsCommand}"
                                Content="Scan Project Contents" />
                        <Button Width="150"
                                Margin="0,0,10,0"
                                Command="{Binding ExportCommand}"
                                Content="Run Export" />
                        <Button Width="120"
                                Command="{Binding CancelExportCommand}"
                                Content="Cancel Export" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="0,0,8,0"
                                 Fill="{Binding HealthCheckIndicatorBrush}" />
                        <TextBlock Foreground="#52624D"
                                   Text="{Binding HealthCheckStatusText}" />
                    </StackPanel>

                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Ellipse Width="12"
                                 Height="12"
                                 Margin="0,0,8,0"
                                 Fill="{Binding HostActivityIndicatorBrush}" />
                        <TextBlock Foreground="#52624D"
                                   Text="{Binding HostActivityStatusText}" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,6"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Installed Versions" />
                    <ListBox Height="220"
                             ItemsSource="{Binding Installations}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10"
                                        Margin="0,0,0,8"
                                        Background="#F8FBF5"
                                        BorderBrush="#DDE7D7"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="#52624D"
                                                   Text="{Binding InstallPath}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding OpennessAvailable, StringFormat=Openness available: {0}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18"
                        BorderBrush="#B7C9B2"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Progress" />
                        <TextBlock Margin="0,14,0,4"
                                   Text="{Binding CurrentObject}" />
                        <ProgressBar Height="18"
                                     Maximum="100"
                                     Value="{Binding ProgressPercent}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#52624D"
                                   Text="{Binding EstimatedRemainingText}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Margin="0,12,0,12"
                        Padding="18"
                        BorderBrush="#B7C9B2"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Succeeded" />
                            <TextBlock FontSize="24"
                                       Text="{Binding SucceededCount}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Failed" />
                            <TextBlock FontSize="24"
                                       Text="{Binding FailedCount}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Text="Issues" />
                            <TextBlock FontSize="24"
                                       Text="{Binding IssueCount}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Padding="18"
                        BorderBrush="#B7C9B2"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Log Output" />
                            <Button DockPanel.Dock="Right"
                                    MinWidth="110"
                                    Margin="12,0,0,0"
                                    Padding="10,4"
                                    Click="OnJumpToLatestLogClicked"
                                    Content="Jump to latest" />
                        </DockPanel>
                        <ListBox Grid.Row="1"
                                 x:Name="LogOutputListBox"
                                 Margin="0,14,0,0"
                                 ItemsSource="{Binding LogEntries}"
                                 FontFamily="Consolas"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2"
                   VerticalAlignment="Bottom"
                   Foreground="#52624D"
                   Text="Milestone 2 includes inventory-driven reporting, Openness traversal abstractions, and cancellable export workflow." />
    </Grid>
</Window>
